SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-side only (Netlify functions and scripts/craft-images.mjs). Mark these
# as secret in Netlify; they must never be written into public/config.js.
ANTHROPIC_API_KEY=sk-ant-...   # writes all generated text (lib/claude.mjs)
OPENAI_API_KEY=sk-...         # images, art and voice transcription; text fallback
ELEVENLABS_API_KEY=...
